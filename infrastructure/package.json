{
  "name": "@family/infrastructure",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AWS CDK v2 application for the Kinmap platform",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint bin config constructs stacks tests",
    "test": "pnpm run prebuild:site && vitest run --passWithNoTests",
    "test:unit": "pnpm run prebuild:site && vitest run --passWithNoTests",
    "synth": "pnpm run prebuild:site && cdk synth --quiet",
    "diff": "pnpm run prebuild:site && cdk diff --method=template",
    "deploy": "pnpm run prebuild:site && cdk deploy",
    "prebuild:site": "pnpm --filter @family/web build"
  },
  "dependencies": {
    "@family/contracts": "workspace:*",
    "aws-cdk-lib": "2.263.0",
    "constructs": "10.8.0"
  },
  "devDependencies": {
    "@family/eslint-config": "workspace:*",
    "@family/tsconfig": "workspace:*",
    "@types/node": "26.1.2",
    "aws-cdk": "2.1134.0",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}

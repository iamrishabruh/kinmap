# Copy to .env.local (git-ignored) for local development, or set these as EAS
# environment variables for CI builds.
#
# ONLY public values belong here. Everything in this file is embedded in the
# shipped binary and must be treated as readable by anyone (spec §29).
# Backend secrets (RevenueCat webhook secret, Apple server API key, FCM
# credentials, APNs signing key, encryption configuration) are NEVER exposed to
# a mobile build — they live in AWS Secrets Manager.

APP_VARIANT=development
APP_NAME=Family Location
APP_BUNDLE_ID=com.example.familylocation
APP_DOMAIN=example.com

API_BASE_URL=https://api.example.com
AWS_REGION=us-east-1

COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=

EAS_PROJECT_ID=
EXPO_PROJECT_SLUG=family-location

SENTRY_DSN=

# RevenueCat PUBLIC SDK keys — safe to embed. The webhook secret is not.
REVENUECAT_PUBLIC_IOS_KEY=
REVENUECAT_PUBLIC_ANDROID_KEY=

# Google sign-in client IDs. The client SECRET must never be in the app.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_MAPS_PUBLIC_KEY=

SUPPORT_EMAIL=support@example.com
PRIVACY_URL=https://example.com/privacy
TERMS_URL=https://example.com/terms

# Copy to .env.local (git-ignored) and `source` it before running CDK commands.
#
#   cp .env.example .env.local && source .env.local
#   pnpm cdk:synth
#
# These are NOT secrets — account ids and hosted zone ids are identifiers, not
# credentials. They live outside Git anyway so the repository stays portable and
# so a fork PR synthesises against placeholders instead of your real account.

# --- AWS accounts ---------------------------------------------------------
# One account is fine to start; point all three at it until you split them.
export AWS_DEV_ACCOUNT_ID=            # 12 digits, from `aws sts get-caller-identity`
export AWS_STAGING_ACCOUNT_ID=
export AWS_PROD_ACCOUNT_ID=
export AWS_REGION=us-east-1

# --- Route 53 -------------------------------------------------------------
# kinmap.app has ONE public hosted zone. Development and staging live in it as
# subdomains, so all three environments share the same id.
export KINMAP_HOSTED_ZONE_ID_DEVELOPMENT=Z00000000000000000
export KINMAP_HOSTED_ZONE_ID_STAGING=Z00000000000000000
export KINMAP_HOSTED_ZONE_ID_PRODUCTION=Z00000000000000000

# --- Domains --------------------------------------------------------------
export KINMAP_DOMAIN_DEVELOPMENT=dev.kinmap.app
export KINMAP_DOMAIN_STAGING=staging.kinmap.app
export KINMAP_DOMAIN_PRODUCTION=kinmap.app

# --- Which environment CDK acts on ----------------------------------------
export CDK_ENVIRONMENT=development

{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@family/tsconfig/base.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["*.ts", "*.mts", "__tests__/**/*.ts"],
  "exclude": ["node_modules"]
}

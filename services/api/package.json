{
  "name": "@family/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KinMap v1 HTTP API Lambda: routing, middleware, account, devices, privacy, configuration, support and entitlements.",
  "main": "./src/handler.ts",
  "types": "./src/handler.ts",
  "exports": {
    ".": "./src/handler.ts"
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly --outDir dist || true",
    "lint": "eslint src",
    "test": "vitest run",
    "test:smoke": "vitest run tests/pipeline.test.ts",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.980.0",
    "@aws-sdk/lib-dynamodb": "3.980.0",
    "@family/auth": "workspace:*",
    "@family/contracts": "workspace:*",
    "@family/observability": "workspace:*",
    "@family/schemas": "workspace:*",
    "@family/validation": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@family/crypto": "workspace:*",
    "@family/eslint-config": "workspace:*",
    "@family/test-utils": "workspace:*",
    "@family/tsconfig": "workspace:*",
    "@types/node": "24.13.3",
    "eslint": "10.8.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
